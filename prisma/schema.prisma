// Learn more about Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
// Tenant is included from the start to support future multi-tenancy.
// All users belong to a Tenant. In the current single-tenant deployment,
// there is one default Tenant row. tenantId is nullable on User so that
// existing records survive the migration; it will be made required once
// multi-tenancy is actively enforced.
// ---------------------------------------------------------------------------

model Tenant {
  id                        String   @id @default(cuid())
  name                      String
  createdAt                 DateTime @default(now())
  profilePermissions        Json? // ProfilePermissions: which fields customer users may self-edit
  renewalLeadDays           Int      @default(30) // recurring sign-offs: how many days before expiry the next cycle opens and "Expiring soon" is flagged
  reviewPeriodMonths        Int      @default(12) // default months between template reviews for newly created templates
  completionRetentionYears  Int      @default(5) // years a signed CompletionRecord must be retained before an admin may delete it (UK H&S guidance: 3-5 years)

  users             User[]
  customerCompanies CustomerCompany[]
  documentTemplates DocumentTemplate[]
}

// ---------------------------------------------------------------------------
// Users
// Consultancy staff and customer users share this model for authentication.
// Customer-role users (Customer Admin / Customer User) link to a
// CustomerCompany via customerCompanyId.
// ---------------------------------------------------------------------------

model User {
  id                String   @id @default(cuid())
  email             String?  @unique // null for no-email workers who sign off via kiosk
  displayName       String
  passwordHash      String? // null for no-email workers (no login possible)
  role              String   @default("Customer User")
  jobRole           String? // freeform job role string used for assignment filtering
  lineManagerId     String? // no-email workers point to their manager for email routing
  employeeNumber    String? // optional kiosk sign-off identity confirmation (P8)
  dateOfBirth       DateTime? @db.Date // optional kiosk sign-off identity confirmation (P8); either this or employeeNumber, not both required
  createdAt         DateTime @default(now())
  tenantId          String? // null = default single-tenant; required when multi-tenancy is enforced
  customerCompanyId String? // null for consultancy staff; required for customer-role users

  tenant          Tenant?            @relation(fields: [tenantId], references: [id])
  customerCompany CustomerCompany?   @relation(fields: [customerCompanyId], references: [id])
  lineManager     User?              @relation("LineManagement", fields: [lineManagerId], references: [id])
  directReports   User[]             @relation("LineManagement")
  passwordReset   PasswordReset?
  completions     CompletionRecord[]
  userAssignments Assignment[]       @relation("UserAssignment")
}

// ---------------------------------------------------------------------------
// Password resets
// One token per user at a time; expires after 1 hour.
// ---------------------------------------------------------------------------

model PasswordReset {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [email], references: [email])
}

// ---------------------------------------------------------------------------
// Document model
// templates → assignments → completions
// ---------------------------------------------------------------------------

// A client business served by the consultancy.
model CustomerCompany {
  id         String   @id @default(cuid())
  name       String
  tenantId   String?
  folderPath String? // blob storage folder path; auto-set on creation
  reviewPeriodMonths Int? // company's own default review period for its self-serve templates; null = inherit the tenant default
  createdAt  DateTime @default(now())

  tenant         Tenant?            @relation(fields: [tenantId], references: [id])
  users          User[]
  assignments    Assignment[]
  ownedTemplates DocumentTemplate[]
}

// A reusable H&S document maintained by the consultancy, or a company-specific
// document created by a Customer Admin (P17 self-serve portal).
// blobPath is the path to the template file in Azure Blob Storage; nullable
// because form-based templates may not have a backing file initially.
// formSchema is a JSON array of FormField objects (see src/types/form-schema.ts)
// that defines the fields the customer must fill in to complete this template.
// ownerCompanyId null = tenant-managed (Simon's library, visible to every company);
// set = created by that CustomerCompany's admin, visible only within that company.
// sourceType 'upload' (P19) means the template is an uploaded Word/PDF document
// rather than a formSchema-driven form; uploadMode then governs whether
// assignees just view+sign sourceDocBlobPath (read-only) or must download it,
// fill it in, and upload their own copy at completion (fill-and-return).
// sourceDocBlobPath is always a PDF (Word originals are converted on upload for
// tamper evidence); sourceDocOriginalBlobPath retains the Word file so it can
// still be edited when the template is renewed.
model DocumentTemplate {
  id                        String   @id @default(cuid())
  title                     String
  description               String?
  blobPath                  String? // path in Azure Blob Storage; null for form-only templates
  formSchema                Json? // array of FormField; null means no form fields defined
  questions                 Json? // array of ComprehensionQuestion; null means no questions defined
  version                   Int      @default(1) // incremented each time a new version is published
  tenantId                  String?
  ownerCompanyId            String? // set when created by a company admin via the self-serve portal
  category                  String   @default("General") // 'COSHH' | 'Fire Safety' | 'First Aid' | 'General' | 'Manual Handling' | 'Other' | 'PPE' | 'Risk Assessment'
  sourceType                String   @default("form") // 'form' | 'upload'
  uploadMode                String? // 'read-only' | 'fill-and-return'; upload templates only
  sourceDocBlobPath         String? // converted, served PDF; upload templates only
  sourceDocOriginalBlobPath String? // retained Word original, for renewal edits; upload templates only
  sourceDocFileName         String? // original filename, for display; upload templates only
  reviewDueAt               DateTime? // next scheduled review (default 12 months after publish); reset by publishing a version or "Reviewed - no changes"
  reviewPeriodMonths        Int      @default(12) // months between reviews; used to set reviewDueAt on create/publish/review
  reviewOwnerId             String? // userId of the admin responsible for the review; receives the 30/7/0-day reminder emails
  lastReviewedAt            DateTime? // when the template was last reviewed or re-published
  lastReviewReminderAt      DateTime? // when the owner was last emailed about this review; cleared whenever the review date is reset
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  tenant         Tenant?                  @relation(fields: [tenantId], references: [id])
  ownerCompany   CustomerCompany?         @relation(fields: [ownerCompanyId], references: [id])
  assignments    Assignment[]
  versionHistory TemplateVersionHistory[]
  reviews        TemplateReview[]
}

// Audit entry for a "Reviewed - no changes" sign-off on a template. Does not
// bump DocumentTemplate.version or trigger re-signing (unlike publishing).
model TemplateReview {
  id         String   @id @default(cuid())
  templateId String
  version    Int // template version that was reviewed
  reviewedAt DateTime @default(now())
  reviewedBy String? // userId
  note       String?

  template DocumentTemplate @relation(fields: [templateId], references: [id])
}

// Records the content of a DocumentTemplate as it was at a superseded version.
// Written by publishNewTemplateVersion just before the version number is
// incremented, so this table only ever holds past (replaced) versions — the
// live version's content lives on DocumentTemplate itself.
model TemplateVersionHistory {
  id           String   @id @default(cuid())
  templateId   String
  version      Int
  changeReason String? // reason the admin gave for replacing this version
  snapshot     Json // {title, description, formSchema, questions} as they were at this version
  publishedAt  DateTime @default(now())
  publishedBy  String? // userId of the admin who published the next version

  template DocumentTemplate @relation(fields: [templateId], references: [id])
}

// Links a DocumentTemplate to a CustomerCompany (company-wide) or to a specific
// User within a company (individual). userId = null means all users in the company
// can see it; userId set means only that user sees it.
// Uniqueness is enforced via two partial indexes in the database migration:
//   - (templateId, customerCompanyId) WHERE userId IS NULL  (one company-wide assignment per template)
//   - (templateId, userId) WHERE userId IS NOT NULL          (one individual assignment per user per template)
model Assignment {
  id                 String    @id @default(cuid())
  templateId         String
  customerCompanyId  String
  userId             String? // null = company-wide; set = individual user
  dueDate            DateTime? // optional deadline; null = no due date
  targetJobRoles     Json? // string[] of job roles that can see this assignment; null = visible to all
  templateVersion    Int       @default(1) // snapshot of template version at assignment creation
  createdAt          DateTime  @default(now())
  lastReminderSentAt DateTime? // set by the reminders cron job each time a reminder is sent for this assignment
  recurrenceMonths   Int? // when set, each completion is valid for this many months (validUntil = signedAt + recurrenceMonths) and is renewed by the daily cron
  cycle              Int       @default(1) // renewal cycle within a template version; the cron creates cycle N+1 (an individual assignment) ahead of expiry
  autoEnroll         Boolean   @default(false) // company-wide only: auto-creates an individual Assignment (enrolment record) for each matching user on creation, and for new/updated users going forward

  template        DocumentTemplate   @relation(fields: [templateId], references: [id])
  customerCompany CustomerCompany    @relation(fields: [customerCompanyId], references: [id])
  user            User?              @relation("UserAssignment", fields: [userId], references: [id])
  completions     CompletionRecord[]
}

// A customer user's signed completion of an assigned document.
// blobPath is nullable — PDF generation is a future step; for now a
// completion is recorded as an audit trail entry only.
// formData stores structured form responses for future Document Intelligence.
// submittedBlobPath/submittedOriginalBlobPath/submittedFileName (P19) hold the
// employee's own filled-in copy for 'fill-and-return' upload templates — the
// converted PDF and retained original, mirroring DocumentTemplate's source
// doc fields. Null for form-based templates and read-only upload templates.
model CompletionRecord {
  id                        String   @id @default(cuid())
  assignmentId              String
  signedById                String // User.id of the signer
  signedAt                  DateTime @default(now())
  blobPath                  String? // path to signed PDF in Azure Blob Storage; null until PDF generation is built
  formData                  Json? // structured form data; populated when Document Intelligence is added
  submittedBlobPath         String? // employee's filled copy, converted to PDF; fill-and-return only
  submittedOriginalBlobPath String? // raw upload as received; fill-and-return only
  submittedFileName         String? // original filename, for display; fill-and-return only
  signerIp                  String? // request IP at signing time (P8 audit trail hardening)
  signerUserAgent           String? // request user-agent at signing time (P8 audit trail hardening)
  validUntil                DateTime? // signedAt + assignment.recurrenceMonths; null = never expires

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  signedBy   User       @relation(fields: [signedById], references: [id])
}
